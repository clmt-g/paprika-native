{
  "name": "supalta/paprika",
  "description": "Projet BTS SIO2 2025",
  "type": "ct",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Paprika\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Clément Guerault",
      "email": "c.guerault@eleve.leschartreux.net"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php" : "^8.3",
    "monolog/monolog" : "^3.9",
    "ext-pdo": "*"
  },
  "require-dev": {
    "php" : "^8.3",
    "symfony/var-dumper": "^7.3",
    "phpdocumentor/shim": "^3.8",
    "phpunit/phpunit": "^12.4"
  },
  "scripts": {
    "serve": [
      "clear",
      "Composer\\Config::disableProcessTimeout",
      "php -S 127.0.0.1:8080"
    ],
    "phpcbf": "vendor/bin/phpcbf -p --standard=PSR12 app",
    "phpcs": "vendor/bin/phpcs -p --standard=PSR12 --report=full app",
    "csfixer": "vendor/bin/php-cs-fixer fix app --rules=@PSR12",
    "csgenerate": "vendor/bin/cs-generator generate",
    "csgen": [
      "mkdir -p storage/reports",
      "vendor/bin/phpcs -p --standard=PSR12 --report=full app > storage/reports/generated.txt || exit 0"
    ],
    "phpstan": [
      "docker run --rm -v $(pwd):/app ghcr.io/phpstan/phpstan analyse -l 6 app --error-format=table"
    ],
    "phpmetrics": "vendor/bin/phpmetrics --report-html=storage/phpmetrics app/",
    "phpmd": "vendor/bin/phpmd app text cleancode,codesize,unusedcode,naming"
  },
  "config": {
    "allow-plugins": {
      "phpdocumentor/shim": true
    }
  }
}
